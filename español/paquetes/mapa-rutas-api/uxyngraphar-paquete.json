{
  "manifiesto_formato": 1,
  "id": "mapa-rutas-api",
  "version": "1.0.0",
  "titulo": "Mapa de rutas de API",
  "descripcion": "Una ficha viva por endpoint HTTP (método, ruta, autenticación, entrada, salida, pipeline y archivos ancla) que se actualiza con cada cambio de la API.",
  "motor": ">=2.0",
  "activacion": ["mapa-rutas-api", "rutas api", "endpoints"],
  "entrada": "ENTRADA.md",
  "verificaciones": ["scripts/verificar.py", "scripts/verificar-rutas.py"],
  "fichas": {
    "ruta": {
      "carpeta": ".",
      "prefijo": "RUT",
      "plantilla": "plantillas/ruta.md",
      "inicial": "activa",
      "status_validos": ["activa", "planificada", "deprecada", "retirada"]
    }
  },
  "ajustes": {"campos_obligatorios": ["method", "path", "auth"], "clave_unica": ["method", "path"]}
}
