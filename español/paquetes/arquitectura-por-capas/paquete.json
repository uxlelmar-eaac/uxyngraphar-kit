{
  "manifiesto_formato": 1,
  "id": "arquitectura-por-capas",
  "version": "1.0.0",
  "titulo": "Arquitectura por capas",
  "descripcion": "Capas de cada módulo (servidor o cliente), qué capa puede importar a cuál, cruces entre módulos solo por integraciones y código común sin dependencias de negocio; se verifica leyendo los imports.",
  "motor": ">=2.0",
  "activacion": [
    "arquitectura-por-capas",
    "arquitectura",
    "capas",
    "modulo nuevo"
  ],
  "entrada": "README.md",
  "verificaciones": [
    "scripts/comun/verificar.py",
    "scripts/verificar-capas.py"
  ],
  "ajustes": {
    "perfil": "servidor",
    "nivel": "aviso",
    "raices": [
      "src"
    ],
    "modulos": [
      "src/modules/*"
    ],
    "comun": [
      "src/common"
    ],
    "alias": {
      "@/": "src/"
    },
    "extensiones": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".py"
    ],
    "excluir": [
      "node_modules",
      "dist",
      "build",
      ".next",
      "__tests__"
    ],
    "perfiles": {
      "servidor": {
        "cruce": "integrations",
        "capas": {
          "presentation": ["application", "security", "sanitization", "contracts"],
          "security": ["application", "domain", "contracts"],
          "sanitization": ["contracts", "domain"],
          "application": ["domain", "infrastructure", "integrations", "contracts", "security"],
          "domain": [],
          "infrastructure": ["domain", "contracts"],
          "contracts": ["domain"],
          "integrations": ["contracts", "domain"]
        }
      },
      "cliente": {
        "cruce": "integrations",
        "capas": {
          "components": ["hooks", "model", "types", "styles"],
          "hooks": ["api", "reception", "model", "types", "integrations"],
          "api": ["types", "model"],
          "reception": ["types", "model"],
          "integrations": ["api", "types", "model"],
          "model": ["types"],
          "types": [],
          "styles": []
        }
      }
    }
  }
}
