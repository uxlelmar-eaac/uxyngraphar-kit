  "endpoints": {
    "info": "GET me/agente (web) · GET v1/me/agente (kit)",
    "turno": "POST me/agente/turno · POST v1/me/agente/turno",
    "turno_stream": "POST me/agente/turno/stream · POST v1/me/agente/turno/stream (SSE)",
    "progreso": "GET me/agente/progreso/:id · GET v1/me/agente/progreso/:id (reserva por sondeo)"
  },
  "codigos_error": ["SIN_IA", "LIMITE", "PROVEEDOR", "SOLICITUD", "INTERNO"],
